{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Mocha All",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/node_modules/mocha/bin/_mocha.js",
      "args": [
          "--timeout",
          "999999",
          "--colors"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
  },
  ]
}